#!/bin/bash

set -e

case $1 in
    install|upgrade)
                INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
                if [ "systemd" == "${INITSYS}" ] || [ "init" == "${INITSYS}" ]; then
                        service hoptodesk stop || true
      sleep 1
                fi
        ;;
esac

exit 0
